
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(roomId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }

    match /rooms/{roomId} {
      allow read: if isMember(roomId);

      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid;

      allow update: if isMember(roomId);

      allow delete: if signedIn() &&
        resource.data.ownerId == request.auth.uid;

      match /members/{memberId} {
        allow get: if signedIn() &&
          request.auth.uid == memberId;

        allow list: if false;

        allow create: if signedIn() &&
          request.auth.uid == memberId &&
          exists(/databases/$(database)/documents/rooms/$(roomId));

        allow update, delete: if signedIn() &&
          request.auth.uid == memberId;
      }

      match /items/{itemId} {
        allow read, delete: if isMember(roomId);

        allow create: if isMember(roomId) &&
          request.resource.data.updatedBy == request.auth.uid;

        allow update: if isMember(roomId) &&
          request.resource.data.updatedBy == request.auth.uid;
      }
    }
  }
}
